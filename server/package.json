    "@nestjs/platform-express": "^11.2.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
